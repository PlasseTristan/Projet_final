@book{vachon_reproduction_2021-1,
	title = {Reproduction artificielle, ensemencements et suivi de la population du chevalier cuivré (\textit{{Moxostoma} hubbsi}) en 2018},
	abstract = {La population de chevalier cuivré (Moxostoma hubbsi) est soutenue par la reproduction artificielle depuis 2004. Les travaux se sont déroulés entre le 4 et le 27 juin 2018. Au total, 23 chevaliers cuivrés (5 femelles, 11 mâles et 7 de sexe indéterminé ou immatures) ont été manipulés en 2018. La capture de ces jeunes individus en juin témoigne vraisemblablement de la contribution significative des spécimens produits depuis 2004. Ces observations de subadultes confirmeraient leur capacité à retourner vers les sites de reproduction d’origine (homing). L’intégration avec succès de deux très jeunes mâles en 2018 est aussi d’un très grand intérêt. Le taux de recapture des géniteurs demeure toutefois élevé. Parmi les 15 géniteurs confirmés, quatre (27 \%) étaient connus. En 2018, 41 familles ont été produites auxquelles s’ajoutent 20 familles potentielles produites au moyen de laitance cryopréservée entre 2012 et 2017. Quelque 117 800 larves ont été ensemencées dans la rivière Richelieu juillet alors que les autres ont été mises dans les étangs de croissance extérieurs ({\textasciitilde}44 670) et dans des bassins intérieurs ({\textasciitilde}8 000) à la station piscicole. Quelque 10 000 fretins ont été relâchés (rivière Richelieu) en septembre. Le suivi du recrutement a été réalisé dans le secteur de Saint-Marc entre le 24 et le 28 septembre. Aucun jeune chevalier cuivré de l’année n’a été capturé.},
	author = {Vachon, Nathalie},
	month = jun,
	year = {2021},
	file = {Full Text PDF:C\:\\Users\\plass\\Zotero\\storage\\NI6JRJ45\\Vachon - 2021 - Reproduction artificielle, ensemencements et suivi de la population du chevalier cuivré (Moxostoma h.pdf:application/pdf},
}

