@article{phillips_root_2003,
	title = {The root of the mammalian tree inferred from whole mitochondrial genomes},
	volume = {28},
	copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
	issn = {10557903},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1055790303000575},
	doi = {10.1016/S1055-7903(03)00057-5},
	abstract = {Morphological and molecular data are currently contradictory over the position of monotremes with respect to marsupial and placental mammals. As part of a re-evaluation of both forms of data we examine complete mitochondrial genomes in more detail. There is a particularly large discrepancy in the frequencies of thymine and cytosine (T–C) between mitochondrial genomes that appears to aﬀect some deep divergences in the mammalian tree. We report that recoding nucleotides to RY-characters, and partitioning maximum-likelihood analyses among subsets of data reduces such biases, and improves the ﬁt of models to the data, respectively. RY-coding also increases the signal on the internal branches relative to external, and thus increases the phylogenetic signal. In contrast to previous analyses of mitochondrial data, our analyses favor Theria (marsupials plus placentals) over Marsupionta (monotremes plus marsupials). However, a short therian stem lineage is inferred, which is at variance with the traditionally deep placement of monotremes on morphological data.},
	language = {en},
	number = {2},
	urldate = {2024-11-05},
	journal = {Molecular Phylogenetics and Evolution},
	author = {Phillips, Matthew J. and Penny, David},
	month = aug,
	year = {2003},
	pages = {171--185},
	file = {Phillips et Penny - 2003 - The root of the mammalian tree inferred from whole.pdf:C\:\\Users\\wegen\\Zotero\\storage\\QBGXN2U9\\Phillips et Penny - 2003 - The root of the mammalian tree inferred from whole.pdf:application/pdf},
}

