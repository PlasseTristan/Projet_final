	file = {Bannester-Marchand et al. - 2025 - Population viability analysis of the endangered co.pdf:C\:\\Users\\wegen\\Zotero\\storage\\2Q4RKD89\\Bannester-Marchand et al. - 2025 - Population viability analysis of the endangered co.pdf:application/pdf},
